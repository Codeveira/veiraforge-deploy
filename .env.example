# Copy to .env and fill in before running docker compose / make.
#
#   cp .env.example .env

# Image to run. `make build`/`make up`/`make deploy` always build from
# ../veiraforge first, so this only matters once VeiraForge starts
# publishing tags to ghcr.io/codeveira/veiraforge.
IMAGE_TAG=latest

# Required -- the bundled Postgres instance's password, also used to build
# VEIRAFORGE_DATABASE_URL for both the veiraforge and worker services.
POSTGRES_PASSWORD=change-me-before-first-run

# Address the server binds to inside the container. Leave as-is unless you
# know why you're changing it.
VEIRAFORGE_LISTEN_ADDR=0.0.0.0:8400

# Encrypts/decrypts Project.DeployToken at rest (AES-256-GCM, 64 hex chars,
# e.g. `openssl rand -hex 32`). Leave unset to keep DeployToken as
# plaintext -- see OPEN-QUESTIONS.md #6 in ../veiraforge.
VEIRAFORGE_MASTER_KEY=

# This dashboard's externally reachable address, e.g. https://ci.example.com
# (no trailing slash). Needed for SSO and GitHub/GitLab OAuth login, and to
# link Codeveira and commit-status reports back to the run page. Both the
# server and the worker read it.
VEIRAFORGE_PUBLIC_BASE_URL=

# Register projects automatically from verified webhook pushes, but only for
# repositories under the namespaces listed here, e.g.
#   github:acme,gitlab:group/sub,gitea:team=https://git.example.com
# (Gitea/Forgejo, and self-hosted GitLab, need their host after "=").
# Empty (the default) leaves registering projects to an admin. A deleted
# project is never registered again automatically.
VEIRAFORGE_AUTO_REGISTER=

# Build artifacts (a pipeline's `artifacts:`) are stored in Postgres. The
# most one run may keep, in MB (0 keeps none), and how long they're kept
# before the server deletes them (0 keeps them forever).
VEIRAFORGE_WORKER_ARTIFACT_MAX_MB=100
VEIRAFORGE_ARTIFACT_RETENTION=720h
# How long finished runs (logs, steps, artifacts) are kept, e.g. 2160h for 90
# days. Each branch's latest finished run is always kept. 0 keeps them all.
VEIRAFORGE_RUN_RETENTION=0

# Prometheus metrics at /metrics, for a scraper that sends this as a
# bearer token (bearer_token in the scrape config). At least 16
# characters, e.g. from `openssl rand -hex 24`. Unset leaves /metrics off.
# VEIRAFORGE_METRICS_TOKEN=

# The largest one pipeline cache (`cache:`) may be, uncompressed, in MB.
# Caches live in the worker-cache volume; unused ones go after 7 days.
VEIRAFORGE_WORKER_CACHE_MAX_MB=1024
# The most all caches together may take, compressed, in MB; past it the
# least recently used go first. 0 for no limit.
VEIRAFORGE_WORKER_CACHE_TOTAL_MAX_MB=10240

# How often the worker polls for a queued run when no webhook triggers one
# directly. Leave as-is unless you know why you're changing it.
VEIRAFORGE_WORKER_POLL_INTERVAL=5s

# Labels this worker has, comma-separated (e.g. docker,arm64). A pipeline
# with runs_on: [docker] only runs on a worker that has every label it
# lists; pipelines without runs_on: run on any worker.
# VEIRAFORGE_WORKER_LABELS=

# The longest one run may take before its steps are killed and it fails
# (e.g. 30m, 3h; 0 = no limit). A pipeline's own `timeout:` in
# .veiraforge.yml can only shorten it.
VEIRAFORGE_WORKER_RUN_TIMEOUT=1h

# ── Steps in containers (optional) ──────────────────────────────────────────
# By default steps run directly in the worker container. To let them run in
# their own images (`image: node:22` in .veiraforge.yml), enable the overlay
# -- read docker-compose.containers.yml first, it mounts the Docker socket:
# COMPOSE_FILE=docker-compose.yml:docker-compose.containers.yml
# DOCKER_GID=
# Image for steps whose pipeline names none (empty: those run in the worker).
# VEIRAFORGE_WORKER_DEFAULT_IMAGE=debian:trixie-slim
# VEIRAFORGE_WORKER_WORK_DIR=/var/lib/veiraforge/work

# ── Webhook secrets (optional, one per platform you actually use) ──────────
# Each one verifies that platform's webhook signature (Azure DevOps and
# Gerrit: the Basic Auth password). Leaving one blank turns that platform's
# webhook off (it answers 503) -- unsigned webhooks are never accepted.
VEIRAFORGE_GITHUB_WEBHOOK_SECRET=
VEIRAFORGE_GITLAB_WEBHOOK_SECRET=
VEIRAFORGE_GITEA_WEBHOOK_SECRET=
VEIRAFORGE_FORGEJO_WEBHOOK_SECRET=
VEIRAFORGE_BITBUCKET_WEBHOOK_SECRET=
VEIRAFORGE_BITBUCKET_SERVER_WEBHOOK_SECRET=
VEIRAFORGE_AZURE_WEBHOOK_SECRET=
VEIRAFORGE_GERRIT_WEBHOOK_SECRET=
VEIRAFORGE_SVN_WEBHOOK_SECRET=
