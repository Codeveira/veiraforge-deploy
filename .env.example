# Copy to .env and fill in before running docker compose / make.
#
#   cp .env.example .env

# Image to run. `make build`/`make up`/`make deploy` always build from
# ../veiraforge first, so this only matters once VeiraForge starts
# publishing tags to ghcr.io/codeveira/veiraforge.
IMAGE_TAG=latest

# Required -- the bundled Postgres instance's password, also used to build
# VEIRAFORGE_DATABASE_URL for both the veiraforge and worker services.
POSTGRES_PASSWORD=change-me-before-first-run

# Address the server binds to inside the container. Leave as-is unless you
# know why you're changing it.
VEIRAFORGE_LISTEN_ADDR=0.0.0.0:8400

# Encrypts/decrypts Project.DeployToken at rest (AES-256-GCM, 64 hex chars,
# e.g. `openssl rand -hex 32`). Leave unset to keep DeployToken as
# plaintext -- see OPEN-QUESTIONS.md #6 in ../veiraforge.
VEIRAFORGE_MASTER_KEY=

# How often the worker polls for a queued run when no webhook triggers one
# directly. Leave as-is unless you know why you're changing it.
VEIRAFORGE_WORKER_POLL_INTERVAL=5s

# ── Webhook secrets (optional, one per platform you actually use) ──────────
# Each one verifies that platform's webhook signature; leave blank to accept
# unsigned webhooks from that platform (fine for a LAN-only/trusted setup).
VEIRAFORGE_GITHUB_WEBHOOK_SECRET=
VEIRAFORGE_GITLAB_WEBHOOK_SECRET=
VEIRAFORGE_GITEA_WEBHOOK_SECRET=
VEIRAFORGE_FORGEJO_WEBHOOK_SECRET=
VEIRAFORGE_BITBUCKET_WEBHOOK_SECRET=
VEIRAFORGE_BITBUCKET_SERVER_WEBHOOK_SECRET=
VEIRAFORGE_AZURE_WEBHOOK_SECRET=
VEIRAFORGE_GERRIT_WEBHOOK_SECRET=
VEIRAFORGE_SVN_WEBHOOK_SECRET=
